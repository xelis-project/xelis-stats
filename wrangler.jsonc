{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xelis-explorer",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // SSR app: unmatched navigations must reach the Worker (app.notFound),
    // never the SPA fallback.
    "not_found_handling": "none"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "xelis-explorer",
      "database_id": "82c1b202-58ed-4252-bda4-5abc2826c3a7"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "94ec460059b64e6fbe2a3075e0d21087"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COLLECTOR",
        "class_name": "StatsCollector"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["StatsCollector"]
    }
  ],
  "ratelimits": [
    {
      "name": "API_RATE",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "EXPENSIVE_RATE",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ],
  "triggers": {
    // "1-59/2" (not "*/2") so the 2-min trigger never lands on minute 0; the
    // hourly trigger below is then the only run at :00, so the hourly-only jobs
    // (asset-supply, daily-rollup, shard-rotation, peer concentration) run once.
    "crons": ["1-59/2 * * * *", "0 * * * *"]
  },
  "vars": {
    "XELIS_NODE": "https://node.xelis.io",
    "XELIS_EXPLORER_DB_ID": "82c1b202-58ed-4252-bda4-5abc2826c3a7",
    "SHARD_MAX_BYTES": "8589934592"
  }
}
