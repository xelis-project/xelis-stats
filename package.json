{
  "name": "xelis-stats",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json",
    "cron": "curl -fsS \"http://localhost:5173/__scheduled\"",
    "deploy": "vite build && wrangler deploy",
    "preview": "vite build && vite preview",
    "cf-typegen": "wrangler types",
    "backfill": "node --experimental-strip-types scripts/backfill.mts",
    "backfill:monitor": "node --experimental-strip-types scripts/monitor.mts",
    "contracts": "node --experimental-strip-types scripts/legacy/contracts.mts",
    "export": "node --experimental-strip-types scripts/export.mts",
    "import:history": "node --experimental-strip-types scripts/legacy/import_history.mts",
    "import:d1": "node --experimental-strip-types scripts/import_d1.mts"
  },
  "dependencies": {
    "bad-words": "^4.1.5",
    "flatpickr": "^4.6.13",
    "hono": "^4.6.0",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260921.1",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "uplot": "^1.6.31",
    "vite": "^8.3.1",
    "wrangler": "^4.0.0"
  }
}
